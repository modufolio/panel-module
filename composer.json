{
    "name": "modufolio/panel-module",
    "description": "The appkit module for modufolio/panel: wires the panel's controllers and fills its host contracts from the kernel.",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Maarten Thiebou"
        }
    ],
    "require": {
        "php": ">=8.4",
        "modufolio/appkit": "^0.22",
        "modufolio/panel": "^0.10",
        "psr/clock": "^1.0",
        "symfony/routing": "^7.0"
    },
    "require-dev": {
        "doctrine/orm": "^3.0",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Modufolio\\PanelModule\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Modufolio\\PanelModule\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "stan": "@php -d memory_limit=1G vendor/bin/phpstan analyse --configuration phpstan.php"
    }
}
